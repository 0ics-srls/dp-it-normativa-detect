{
  "specVersion": "1.1",
  "type": "stdin",
  "name": "dp-it-normativa-detect",
  "version": "0.1.0",
  "description": "Turns the configured Normattiva / Gazzetta Ufficiale acts into catalog items (one per act and refresh version). No network. Proc-protocol v1.1: spec, check, run.",
  "author": "open-lex-it",
  "authentication": false,
  "actions": {
    "spec": {
      "description": "Return the config and output JSON schemas (Proc-protocol 1.1).",
      "input": { "type": "object", "properties": {} },
      "output": {
        "type": "object",
        "properties": {
          "configSchema": { "type": "object" },
          "outputSchema": { "type": "object" },
          "protocol": { "type": "string", "const": "1.1" }
        }
      }
    },
    "check": {
      "description": "Test Source: validates kind and acts (shape, denominazione allow-list, ranges). No request is made; grab checks that an act exists.",
      "input": {
        "type": "object",
        "properties": {
          "kind": { "enum": ["normattiva", "gu"] },
          "acts": { "type": "array", "minItems": 1, "maxItems": 50, "items": { "type": "object" } }
        },
        "required": ["kind", "acts"]
      },
      "output": { "type": "object", "properties": { "ok": { "type": "boolean" } } }
    },
    "run": {
      "description": "Items are the acts whose key is not in state.seen; a refreshToken change re-emits every act.",
      "input": {
        "type": "object",
        "properties": {
          "kind": { "enum": ["normattiva", "gu"] },
          "acts": { "type": "array", "minItems": 1, "maxItems": 50, "items": { "type": "object" } },
          "refreshToken": { "type": ["string", "null"] },
          "state": {
            "type": ["object", "null"],
            "properties": { "seen": { "type": "array", "items": { "type": "string" } } }
          }
        },
        "required": ["kind", "acts"]
      },
      "output": {
        "type": "object",
        "properties": {
          "items": { "type": "array" },
          "state": { "type": "object" },
          "metrics": { "type": "object" },
          "checks": { "type": "array" }
        }
      }
    },
    "execute": {
      "description": "Alias of run for Proc-protocol v1 callers (ProcMon mandates execute); same input and result as run.",
      "input": {
        "type": "object",
        "properties": {
          "kind": { "enum": ["normattiva", "gu"] },
          "acts": { "type": "array", "minItems": 1, "maxItems": 50, "items": { "type": "object" } },
          "refreshToken": { "type": ["string", "null"] },
          "state": {
            "type": ["object", "null"],
            "properties": { "seen": { "type": "array", "items": { "type": "string" } } }
          }
        },
        "required": ["kind", "acts"]
      },
      "output": {
        "type": "object",
        "properties": {
          "items": { "type": "array" },
          "state": { "type": "object" },
          "metrics": { "type": "object" },
          "checks": { "type": "array" }
        }
      }
    },
    "terminate": {
      "description": "Stop and clean up.",
      "input": { "type": "object", "properties": {} }
    }
  },
  "execution": {
    "timeout": 600,
    "memoryLimit": "256Mi",
    "cpuLimit": "0.5"
  }
}
